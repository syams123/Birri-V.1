rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function validProfile() {
      let d = request.resource.data;
      return d.keys().hasOnly(['displayName','updatedAt']) && d.keys().hasAll(['displayName','updatedAt']) && d.displayName is string && d.displayName.size() <= 256 && d.updatedAt == request.time;
    }
    function validLog() {
      let d = request.resource.data;
      return d.keys().hasOnly(['waqiah','mulk','hadis','sholawat','dzikir','kahfi','yasin','shad'])
        && d.get('waqiah',false) is bool && d.get('mulk',false) is bool
        && d.get('hadis',false) is bool && d.get('sholawat',false) is bool
        && d.get('dzikir',false) is bool && d.get('kahfi',false) is bool
        && d.get('yasin',false) is bool && d.get('shad',false) is bool;
    }
    match /users/{uid} {
      allow get: if owner(uid);
      allow create, update: if owner(uid) && validProfile();
      match /dailyLogs/{day} {
        allow read: if owner(uid);
        allow create, update: if owner(uid) && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && validLog();
      }
    }
  }
}
